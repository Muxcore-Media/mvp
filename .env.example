API_REST_HTTP_ADDR=:18080
API_REST_GRPC_ADDR=:9400
SMOKE_API_URL=http://127.0.0.1:18080
SMOKE_CORE_URL=http://127.0.0.1:8080
SMOKE_ADMIN_URL=http://localhost:8082
SMOKE_JELLYFIN_URL=http://127.0.0.1:8475
SMOKE_TIMEOUT_SEC=180
MUXCORE_LOG_LEVEL=info
MUXCORE_STORAGE_DIR=./data/storage

# Spool `default` includes ratelimit-tokenbucket (started by run-host; fail-open until enabled).
# RATELIMIT_ENABLED=true
# RATELIMIT_RATE=100
# RATELIMIT_BURST=200

# Spool `default` includes cache-redis. Opt-in: reuse :6379, else podman redis:7-alpine, else redis-server on PATH.
# MVP_ENABLE_CACHE_REDIS=1
# REDIS_ADDR=127.0.0.1:6379
# CACHE_GRPC_ADDR=:9600

# TMDB: set a real key for live search, or TMDB_FIXTURE=1 for offline Fight Club / Breaking Bad fixtures
# TMDB_API_KEY=
# TMDB_FIXTURE=1


MVP_ENABLE_MEDIA_UI=1
# Optional: seed movie-request/tv-request DAGs (mesh RPC adapters; :9603)
# MVP_ENABLE_WORKFLOW_TAPESTRY=1
# Optional: import-list sync (:9530) — compose profile: list-sync; admin /list-sync
# MVP_ENABLE_MEDIA_LIST_SYNC=1
# Optional: Apprise notification peer (:9445) — compose profile: apprise
# MVP_ENABLE_NOTIFICATION_APPRISE=1
# APPRISE_URL=http://127.0.0.1:8000
# APPRISE_URLS=
# APPRISE_WEBHOOK_URL=http://127.0.0.1:9/muxcore-apprise-sink

# Dev mesh TLS: run-host.sh sets MUXCORE_INSECURE_DISABLE_TLS=true by default.
# Staging/production: use run-host-staging.sh + mvp/tls/MTLS-STAGING.md (leave unset).
# MUXCORE_INSECURE_DISABLE_TLS=true

# Dev-only local auth bootstrap (do not use in production)
MVP_ADMIN_USER=admin
MVP_ADMIN_PASSWORD=admin-dev-only
AUTH_GRPC_ADDR=127.0.0.1:9403
# Browser-facing auth (Caddy); keep internal loopback for server-side exchange.
AUTH_HTTP_URL=https://auth.gringotts
AUTH_HTTP_INTERNAL_URL=http://127.0.0.1:9401
MEDIA_UI_PUBLIC_URL=https://media.gringotts
ADMIN_UI_AUTH_ADDR=https://auth.gringotts
ADMIN_UI_AUTH_INTERNAL_ADDR=http://127.0.0.1:9401
ADMIN_UI_PUBLIC_URL=https://admin.gringotts
ADMIN_UI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
MOVIES_GRPC_ADDR=127.0.0.1:9420
TVSHOWS_GRPC_ADDR=127.0.0.1:9440
ROOTS_GRPC_ADDR=127.0.0.1:9540
JELLYFIN_GRPC_CLIENT_ADDR=127.0.0.1:9475
# Optional live Jellyfin server (leave empty for soft/unconfigured bridge smoke)
# JELLYFIN_BASE_URL=http://127.0.0.1:8096
# JELLYFIN_API_KEY=
# JELLYFIN_WEBHOOK_SECRET=
# Live smoke (Status configured + RefreshLibrary + SyncLibrary): auto when both URL+key set, or force with SMOKE_LIVE_JELLYFIN=1
# SMOKE_LIVE_JELLYFIN=1
# SMOKE_LIVE_JELLYFIN=0   # disable auto even when URL+key are set
AUTOMATION_GRPC_CLIENT_ADDR=127.0.0.1:9460
SCANNER_GRPC_CLIENT_ADDR=127.0.0.1:9470
# Host stack only: rewrite empty discovery hosts to 127.0.0.1 (see media-automation)
# MUXCORE_MESH_DIAL_LOCAL=true
# Library paths (on gringotts use mass-storage datapool, e.g. /mnt/mass-storage/media/movies).
MVP_LIBRARY_ROOT=./data/library
MVP_TV_LIBRARY_ROOT=./data/library/tv
MVP_DOWNLOADS_DIR=./data/downloads
MVP_TOKEN_FILE=./run/admin.token
