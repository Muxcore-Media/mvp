API_REST_HTTP_ADDR=:18080
API_REST_GRPC_ADDR=:9400
SMOKE_API_URL=http://127.0.0.1:18080
SMOKE_CORE_URL=http://127.0.0.1:8080
SMOKE_ADMIN_URL=http://localhost:8082
SMOKE_JELLYFIN_URL=http://127.0.0.1:8475
SMOKE_TIMEOUT_SEC=180
MUXCORE_LOG_LEVEL=info
MUXCORE_STORAGE_DIR=./data/storage

# Spool `default` includes ratelimit-tokenbucket (started by run-host; fail-open until enabled).
# RATELIMIT_ENABLED=true
# RATELIMIT_RATE=100
# RATELIMIT_BURST=200

# Spool `default` includes cache-redis. Opt-in: reuse :6379, else podman redis:7-alpine, else redis-server on PATH.
# MVP_ENABLE_CACHE_REDIS=1
# REDIS_ADDR=127.0.0.1:6379
# CACHE_GRPC_ADDR=:9600

# Optional: S3/MinIO storage sidecar (:9610 gRPC, :9611 health) — start MinIO first (storage-s3/deploy/docker-compose.yml)
# MVP_ENABLE_STORAGE_S3=1
# S3_ENDPOINT=127.0.0.1:9000
# S3_BUCKET=muxcore
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PATH_STYLE=true
# STORAGE_S3_GRPC_ADDR=127.0.0.1:9610
# STORAGE_S3_HTTP_ADDR=127.0.0.1:9611

# TMDB: set a real key for live search, or TMDB_FIXTURE=1 for offline Fight Club / Breaking Bad fixtures.
# Prefer TMDB_FIXTURE=1 on hosts without a key (smoke -require-search). Secret rotation still needed for live TMDB.
# TMDB_API_KEY=
# TMDB_FIXTURE=1


MVP_ENABLE_MEDIA_UI=1
# Optional: seed movie-request/tv-request DAGs (mesh RPC adapters; :9603)
# MVP_ENABLE_WORKFLOW_TAPESTRY=1
# Optional: household userdata mesh (:9672) — set USERDATA_LOCAL_URL for BFF/jellyfin
# MVP_ENABLE_USERDATA_LOCAL=1
# USERDATA_LOCAL_URL=http://127.0.0.1:9672
# USERDATA_SYNC=1
# USERDATA_PUSH_TO_JELLYFIN=0

# Optional: qBittorrent WebUI peer (:9462/:9463) — fixture by default
# MVP_ENABLE_DOWNLOADER_QBITTORRENT=1
# QBIT_FIXTURE=1
# QBIT_URL=http://127.0.0.1:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=

# Optional library-plus modules (gRPC/HTTP :9650–9671) — compose profiles: books, comics, audiobooks
#   docker compose --profile books --profile comics --profile audiobooks up -d
# run-host equivalents (off by default):
# MVP_ENABLE_MEDIA_BOOKS=1
# MVP_ENABLE_MEDIA_COMICS=1
# MVP_ENABLE_MEDIA_AUDIOBOOKS=1
# MEDIA_BOOKS_HTTP_PORT=9651
# MEDIA_COMICS_HTTP_PORT=9661
# MEDIA_AUDIOBOOKS_HTTP_PORT=9671

# Optional: import-list sync (gRPC :9530) — compose profile: list-sync; admin /list-sync
#   docker compose --profile list-sync up -d
# run-host equivalent (off by default):
# MVP_ENABLE_MEDIA_LIST_SYNC=1
# LISTSYNC_GRPC_PORT=9530
# LISTSYNC_GRPC_CLIENT_ADDR=127.0.0.1:9530   # BFF default; compose media-ui uses media-list-sync:9530
# Optional: library maintenance / cleanup rules (gRPC :9545) — compose profile: library-maintainer
#   docker compose --profile library-maintainer up -d
# run-host equivalent (off by default):
# MVP_ENABLE_MEDIA_LIBRARY_MAINTAINER=1
# MAINTAINER_GRPC_PORT=9545
# MAINTAINER_USERDATA_DIR=./data/userdata   # run-host default; compose shares userdata-data with userdata-local
# Optional: unified media graph (gRPC :9730, admin HTTP :9731) — compose profile: graph
#   docker compose --profile graph up -d
# BFF related-titles rail: GET /api/graph/related (media-ui); run-host: MVP_ENABLE_MEDIA_GRAPH=1
# MVP_ENABLE_MEDIA_GRAPH=1
# MEDIA_GRAPH_GRPC_PORT=9730
# MEDIA_GRAPH_HTTP_PORT=9731
# GRAPH_AUTO_LINK=true
# GRAPH_INGEST_ENABLED=true
# GRAPH_INGEST_INTERVAL=15m
# GRAPH_HTTP_URL=http://127.0.0.1:9731   # compose media-ui uses http://media-graph:9731
# GRAPH_MODULE_TOKEN=          # only if graph requires admin token (non-loopback)
# GRAPH_HTTP_TOKEN=            # alias for GRAPH_MODULE_TOKEN / mediauiprox -graph-token
# Optional: FFmpeg transcoder (gRPC :9525, playback HTTP :9526) — compose profile: transcoder
# Playback transcode for media-ui starts automatically with run-host when media UI is enabled.
# Requires ffmpeg on PATH (run-host may link nix ffmpeg into mvp/bin).
# MVP_ENABLE_MEDIA_TRANSCODER=1
# MVP_ENABLE_MEDIA_TRANSCODER=0   # disable even when media UI is on
# Optional: Apprise notification peer (gRPC :9445) — compose profile: apprise
#   docker compose --profile apprise up -d
# run-host equivalent (off by default):
# MVP_ENABLE_NOTIFICATION_APPRISE=1
# NOTIFICATION_APPRISE_GRPC_PORT=9445
# APPRISE_URL=http://127.0.0.1:8000
# APPRISE_URLS=
# APPRISE_TOKEN=
# DISCORD_WEBHOOK=
# SLACK_WEBHOOK=
# APPRISE_WEBHOOK_URL=http://127.0.0.1:9/muxcore-apprise-sink

# Optional: household backup sidecar (gRPC :9302, health :9303) — compose profile: backup-local
# MVP_ENABLE_BACKUP_LOCAL=1
# BACKUP_DIR=./data/backup
# BACKUP_SOURCE_DIRS=./data/auth,./data/sqlite,./data/userdata
# BACKUP_SCHEDULE_CRON=0 3 * * *
# BACKUP_RETENTION_COUNT=10
# BACKUP_RETENTION_DAYS=30

# Dev mesh TLS: run-host.sh sets MUXCORE_INSECURE_DISABLE_TLS=true by default.
# Staging/production: use run-host-staging.sh + mvp/tls/MTLS-STAGING.md (leave unset).
# MUXCORE_INSECURE_DISABLE_TLS=true

# Dev-only local auth bootstrap (do not use in production)
MVP_ADMIN_USER=admin
MVP_ADMIN_PASSWORD=admin-dev-only
AUTH_GRPC_ADDR=127.0.0.1:9403
# Browser-facing auth (Caddy); keep internal loopback for server-side exchange.
# Public URLs (vault/soak uses nix `muxcore-test.nix`; local dev uses *.gringotts).
# On vault, do not set these in mvp/.env — systemd provides https://*.zem.systems.
# Public URLs (vault/soak: set in nix `muxcore-test.nix` as https://*.zem.systems — do not duplicate ZT addresses in mvp/.env)
AUTH_HTTP_URL=https://auth.gringotts
AUTH_HTTP_INTERNAL_URL=http://127.0.0.1:9401
MEDIA_UI_PUBLIC_URL=https://media.gringotts
ADMIN_UI_AUTH_ADDR=https://auth.gringotts
ADMIN_UI_AUTH_INTERNAL_ADDR=http://127.0.0.1:9401
ADMIN_UI_PUBLIC_URL=https://admin.gringotts
# Comma-separated CIDRs for dawn/dusk edge proxies (public HTTPS). Include ZT /128 of each edge.
ADMIN_UI_TRUSTED_PROXIES=127.0.0.1/32,::1/128,fd2c:a2fd:5d9e:ab72:9d99:932c:a2fd:5d9e/128,fd2c:a2fd:5d9e:ab72:9d99:939b:2e68:dd6d/128
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128,fd2c:a2fd:5d9e:ab72:9d99:932c:a2fd:5d9e/128,fd2c:a2fd:5d9e:ab72:9d99:939b:2e68:dd6d/128
MOVIES_GRPC_ADDR=127.0.0.1:9420
TVSHOWS_GRPC_ADDR=127.0.0.1:9440
ROOTS_GRPC_ADDR=127.0.0.1:9540
JELLYFIN_GRPC_CLIENT_ADDR=127.0.0.1:9475
# Optional live Jellyfin server (leave empty for soft/unconfigured bridge smoke)
# JELLYFIN_BASE_URL=http://127.0.0.1:8096
# JELLYFIN_API_KEY=
# JELLYFIN_WEBHOOK_SECRET=
# Live smoke (Status configured + RefreshLibrary + SyncLibrary): auto when both URL+key set, or force with SMOKE_LIVE_JELLYFIN=1
# SMOKE_LIVE_JELLYFIN=1
# SMOKE_LIVE_JELLYFIN=0   # disable auto even when URL+key are set
AUTOMATION_GRPC_CLIENT_ADDR=127.0.0.1:9460
SCANNER_GRPC_CLIENT_ADDR=127.0.0.1:9470
# media-custom-formats (:9490) — TRaSH Guides sync on start (default on in run-host.sh).
# FORMATS_TRASH_SYNC=true
# FORMATS_TRASH_IMPORT_PROFILES=true
# FORMATS_TRASH_SCORE_SET=default
# FORMATS_TRASH_GUIDES_PATH=   # optional local clone; else downloads GitHub archive into FORMATS_TRASH_CACHE_DIR
# FORMATS_TRASH_SYNC=false     # disable and keep only lightweight seed formats
# Host stack only: rewrite empty discovery hosts to 127.0.0.1 (see media-automation)
# MUXCORE_MESH_DIAL_LOCAL=true
# Library paths (on gringotts use mass-storage datapool — see docs/ACQUISITION.md).
# gringotts: MVP_LIBRARY_ROOT=/mnt/mass-storage/media/movies
# gringotts: MVP_TV_LIBRARY_ROOT=/mnt/mass-storage/media/shows
# gringotts: MVP_DOWNLOADS_DIR=/mnt/mass-storage/media/torrents
MVP_LIBRARY_ROOT=./data/library
MVP_TV_LIBRARY_ROOT=./data/library/tv
MVP_DOWNLOADS_DIR=./data/downloads
MVP_TOKEN_FILE=./run/admin.token

# ── Opt-in indexer / torrent (VPN-gated for live). Off by default.
# Operator runbook: docs/ACQUISITION.md (enable/disable live acquisition, NAS ACLs, backup excludes).
# Spool tag `acquisition` = fixture ingest helpers only (scanner/roots/list-sync). It does NOT start
# pirate/torznab/torrent peers — use MVP_ENABLE_* below. Never enable live Pirate Bay / swarm without VPN.
#
# WireGuard (required for live indexer HTTP + live torrent engine on gringotts):
#   WG_CONF=/path/to/wg-mux.conf   # mode 600; source-routed iface from conf basename
#   WG_USE_WG_QUICK=0              # NEVER 1 on mesh hub (full-tunnel kill-switch breaks SSH)
#   WG_KILL_SWITCH=false
# WG_CONF=
# WG_USE_WG_QUICK=0
# WG_KILL_SWITCH=false

# indexer-piratebay (:9485). Fixture/soft-empty preferred — do NOT set PIRATEBAY_API_BASE unless intentional + VPN.
# Fixture offline: MVP_ENABLE_INDEXER_PIRATEBAY=1 INDEXER_FIXTURE=1
# Live-capable (still leave API base empty until ready): MVP_ENABLE_INDEXER_PIRATEBAY=1 + WG_CONF
# MVP_ENABLE_INDEXER_PIRATEBAY=0
# INDEXER_FIXTURE=1
# PIRATEBAY_GRPC_ADDR=:9485
# PIRATEBAY_API_BASE=   # leave empty; e.g. https://apibay.org only behind WG_CONF

# indexer-torznab (:9486). Empty/loopback TORZNAB_URL OK without VPN; remote URLs require WG_CONF.
# MVP_ENABLE_INDEXER_TORZNAB=0
# TORZNAB_GRPC_ADDR=:9486
# TORZNAB_URL=
# TORZNAB_API_KEY=
# TORZNAB_NAME=Torznab

# downloader-native-torrent (:9461). Fixture engine by default; live engine only when WG_CONF is set.
# DOWNLOAD_DIR defaults to /mnt/mass-storage/media/torrents when that dir exists, else ./data/downloads.
# MVP_ENABLE_DOWNLOADER_TORRENT=0
# DOWNLOADER_GRPC_ADDR=:9461
# DOWNLOADER_ENGINE=fixture
# DOWNLOAD_DIR=
# NAT_PMP_PORT=0

# downloader-qbittorrent (:9462/:9463). Optional WebUI bridge; fixture needs no live qBit.
# MVP_ENABLE_DOWNLOADER_QBITTORRENT=0
# QBITTORRENT_GRPC_ADDR=:9462
# QBIT_FIXTURE=1
# # or: DOWNLOADER_ENGINE=fixture
# QBITTORRENT_URL=          # e.g. http://127.0.0.1:8080 (operator opt-in)
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=

# downloader-native-usenet (:9622/:9623). Native usenet engine; fixture by default.
# MVP_ENABLE_DOWNLOADER_USENET=0
# USENET_ENGINE=fixture
# USENET_DOWNLOAD_DIR=
# USENET_PAR2=auto
# USENET_UNPACK=auto
# USENET_CLEANUP=0
# UNRAR_CMD=unrar
# SEVENZIP_CMD=7z
# NNTP_HOST=
# NNTP_PORT=563
# NNTP_USER=
# NNTP_PASS=
# NNTP_SSL=1

# downloader-sabnzbd (:9620/:9621). Optional SABnzbd usenet bridge; leave unset unless intentional.
# MVP_ENABLE_DOWNLOADER_SABNZBD=0
# SABNZBD_URL=
# SABNZBD_API_KEY=

# media-graph: see optional compose profile `graph` above (umbrella #129).
