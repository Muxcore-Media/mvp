# Production acquisition profile — source before ./run-host.sh up
# See docs/ACQUISITION-PRODUCTION.md

# Mesh / security (vault should set MUXCORE_REQUIRE_TLS=1 in Nix)
export MUXCORE_PROFILE=dev
export MUXCORE_INSECURE_DISABLE_TLS=true

# VPN — required for live torrent + live indexer HTTP
# export WG_CONF=/path/to/wg-mux.conf
export DOWNLOADER_REQUIRE_VPN=1

# Acquisition peers
export MVP_ENABLE_DOWNLOADER_TORRENT=1
export DOWNLOADER_ENGINE=live
export MVP_ENABLE_INDEXER_PIRATEBAY=1
# export MVP_ENABLE_INDEXER_TORZNAB=1

# Origin pinning (default); use MVP_ALLOW_ADHOC_BUILD=1 only on dev laptops
# export MVP_ALLOW_ADHOC_BUILD=0

# Metadata + household stack
export TMDB_API_KEY=
export MVP_ENABLE_USERDATA_LOCAL=1
export USERDATA_SYNC=1

# Standalone Jellyfin at media.zem.systems — disable MuxCore bridge unless testing sync
export MVP_ENABLE_JELLYFIN=0

# Automation tuning
export AUTOMATION_EVENT_SUBSCRIBE_DELAY=1s
export MVP_DOWNLOADS_DIR=

# Secrets — set in vault sops, not here
# export TMDB_API_KEY=...
